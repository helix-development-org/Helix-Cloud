  {
   "body.sy": "1 + 0.025 * sin((age + 76) * 0.09)",
   "body.sx": "1 + 0.012 * sin((age + 76) * 0.09)",
   "body.rz": "body.rz + sin(limb_swing * 0.6662) * min(limb_speed, 1) * 0.06",
   "head.rz": "head.rz + sin(limb_swing * 0.6662) * min(limb_speed, 1) * 0.16 + sin((age + 76) * 0.045) * 0.05",
   "head.rx": "head.rx + if(hurt_time > 0, -0.3 * hurt_time / 10, sin((age + 76) * 0.06) * 0.03)",
   "head.sy": "1 + abs(sin(limb_swing * 0.6662) * min(limb_speed, 1)) * 0.06",
   "head.sx": "1 - abs(sin(limb_swing * 0.6662) * min(limb_speed, 1)) * 0.03",
   "left_ear_cube.rz": "left_ear_cube.rz + if(frac((age + 228) / 70) < 0.06, sin(age * 1.8) * 0.3, 0)",
   "right_ear_cube.rz": "right_ear_cube.rz + if(frac((age + 228) / 70) < 0.06, sin(age * 1.8) * 0.3, 0)",
   "tail.ry": "tail.ry + sin((age + 76) * 0.32) * 0.35",
   "kl_lid_l.visible": "frac((age + 532) / 116) > 0.955 || hurt_time > 0",
   "kl_lid_r.visible": "frac((age + 532) / 116) > 0.955 || hurt_time > 0"
  }
 ],
