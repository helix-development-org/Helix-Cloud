  {
   "body.sy": "1 + 0.025 * sin((age + 3) * 0.09)",
   "body.sx": "1 + 0.012 * sin((age + 3) * 0.09)",
   "body.rz": "body.rz + sin(limb_swing * 0.6662) * min(limb_speed, 1) * 0.06",
   "head_cube.rz": "head_cube.rz + sin(limb_swing * 0.6662) * min(limb_speed, 1) * 0.16 + sin((age + 3) * 0.045) * 0.05",
   "head_cube.rx": "head_cube.rx + if(hurt_time > 0, -0.3 * hurt_time / 10, sin((age + 3) * 0.06) * 0.03)",
   "head_cube.sy": "1 + abs(sin(limb_swing * 0.6662) * min(limb_speed, 1)) * 0.06",
   "head_cube.sx": "1 - abs(sin(limb_swing * 0.6662) * min(limb_speed, 1)) * 0.03",
   "left_ear.rz": "left_ear.rz + if(frac((age + 9) / 70) < 0.06, sin(age * 1.8) * 0.3, 0)",
   "right_ear.rz": "right_ear.rz + if(frac((age + 9) / 70) < 0.06, sin(age * 1.8) * 0.3, 0)",
   "right_ear_cube.rz": "right_ear_cube.rz + if(frac((age + 9) / 70) < 0.06, sin(age * 1.8) * 0.3, 0)",
   "kl_lid_l.visible": "frac((age + 21) / 83) > 0.955 || hurt_time > 0",
   "kl_lid_r.visible": "frac((age + 21) / 83) > 0.955 || hurt_time > 0"
  }
