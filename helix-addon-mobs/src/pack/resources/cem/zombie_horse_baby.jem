   "head.rx": "head.rx + if(hurt_time > 0, -0.3 * hurt_time / 10, sin((age + 49) * 0.06) * 0.03)",
   "head.sy": "1 + abs(sin(limb_swing * 0.6662) * min(limb_speed, 1)) * 0.06",
   "head.sx": "1 - abs(sin(limb_swing * 0.6662) * min(limb_speed, 1)) * 0.03",
   "left_ear.rz": "left_ear.rz + if(frac((age + 147) / 70) < 0.06, sin(age * 1.8) * 0.3, 0)",
   "right_ear.rz": "right_ear.rz + if(frac((age + 147) / 70) < 0.06, sin(age * 1.8) * 0.3, 0)",
   "tail.ry": "tail.ry + sin((age + 49) * 0.32) * 0.35",
   "kl_lid_l.visible": "frac((age + 343) / 89) > 0.955 || hurt_time > 0",
