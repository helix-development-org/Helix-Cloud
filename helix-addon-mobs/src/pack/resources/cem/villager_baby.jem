  {
   "body.sy": "1 + 0.025 * sin((age + 5) * 0.09)",
   "body.sx": "1 + 0.012 * sin((age + 5) * 0.09)",
   "body.rz": "body.rz + sin(limb_swing * 0.6662) * min(limb_speed, 1) * 0.06",
   "head.rz": "head.rz + sin(limb_swing * 0.6662) * min(limb_speed, 1) * 0.16 + sin((age + 5) * 0.045) * 0.05",
   "head.rx": "head.rx + if(hurt_time > 0, -0.3 * hurt_time / 10, sin((age + 5) * 0.06) * 0.03)",
   "head.sy": "1 + abs(sin(limb_swing * 0.6662) * min(limb_speed, 1)) * 0.06",
   "head.sx": "1 - abs(sin(limb_swing * 0.6662) * min(limb_speed, 1)) * 0.03",
   "headwear.rz": "headwear.rz + if(frac((age + 15) / 70) < 0.06, sin(age * 1.8) * 0.3, 0)",
   "headwear2.rz": "headwear2.rz + if(frac((age + 15) / 70) < 0.06, sin(age * 1.8) * 0.3, 0)",
   "bodywear.rz": "bodywear.rz + if(frac((age + 15) / 70) < 0.06, sin(age * 1.8) * 0.3, 0)",
   "kl_lid_l.visible": "frac((age + 35) / 85) > 0.955 || hurt_time > 0",
   "kl_lid_r.visible": "frac((age + 35) / 85) > 0.955 || hurt_time > 0"
  }
